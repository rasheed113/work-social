import { useEffect, useMemo, useState } from 'react';
import { navigate } from '../../../app/Router';
import { supabase } from '../../../lib/supabase/client';
import { ContractorNewEntryModal, type ContractorEntryInput } from './ContractorNewEntryModal';
import { ContractorEntryEditModal } from './ContractorEntryEditModal';
import { formatContractorMoney } from '../logic/contractorEntryCalculations';

type Entry={id:string;item_name:string;size:string;pieces:number;rate_per_piece:number;commission_type:'percentage'|'per_piece'|null;commission_value:number|null;commission_mode:'included'|'separate'|null;commission_per_piece:number;actual_rate_per_piece:number;total:number;occurred_at:string;special_note?:string|null};
type Totals={daily_total:number;weekly_total:number;monthly_total:number;lifetime_total:number;commission_total:number};
type PeriodCard='daily'|'weekly'|'monthly'|'grand';
type Period={start:string|null;end:string|null;label:string;total:number;commission:number};
interface Props{profileId:string;displayName:string|null}
const zero:Totals={daily_total:0,weekly_total:0,monthly_total:0,lifetime_total:0,commission_total:0};
const dayKey=(d:Date)=>{const p=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Karachi',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(d),g=(x:string)=>p.find(a=>a.type===x)?.value??'';return `${g('year')}-${g('month')}-${g('day')}`};
const dateFromKey=(k:string)=>new Date(`${k}T00:00:00+05:00`);const shiftDayKey=(k:string,n:number)=>dayKey(new Date(dateFromKey(k).getTime()+n*86400000));const weekStartKey=(k:string)=>shiftDayKey(k,-((dateFromKey(k).getUTCDay()+6)%7));const monthStartKey=(k:string)=>`${k.slice(0,7)}-01`;
const periodFor=(t:PeriodCard,k:string):Period=>{if(t==='grand')return{start:null,end:null,label:'All recorded work',total:0,commission:0};if(t==='daily'){const e=shiftDayKey(k,1);return{start:`${k}T00:00:00+05:00`,end:`${e}T00:00:00+05:00`,label:new Intl.DateTimeFormat('en-PK',{timeZone:'Asia/Karachi',day:'numeric',month:'short',year:'numeric'}).format(dateFromKey(k)),total:0,commission:0}}if(t==='weekly'){const s=weekStartKey(k),e=shiftDayKey(s,7);return{start:`${s}T00:00:00+05:00`,end:`${e}T00:00:00+05:00`,label:`${new Intl.DateTimeFormat('en-PK',{timeZone:'Asia/Karachi',day:'numeric',month:'short'}).format(dateFromKey(s))} – ${new Intl.DateTimeFormat('en-PK',{timeZone:'Asia/Karachi',day:'numeric',month:'short',year:'numeric'}).format(dateFromKey(shiftDayKey(e,-1)))}`,total:0,commission:0}}const s=monthStartKey(k),n=dayKey(new Date(dateFromKey(s).getTime()+32*86400000)).slice(0,7),e=`${n}-01`;return{start:`${s}T00:00:00+05:00`,end:`${e}T00:00:00+05:00`,label:new Intl.DateTimeFormat('en-PK',{timeZone:'Asia/Karachi',month:'long',year:'numeric'}).format(dateFromKey(s)),total:0,commission:0}};
const bounds=()=>{const k=dayKey(new Date()),d=dateFromKey(k),e=new Date(d.getTime()+86400000),w=weekStartKey(k),ws=dateFromKey(w),m=monthStartKey(k),ms=dateFromKey(m),mn=dayKey(new Date(ms.getTime()+32*86400000)).slice(0,7);return{p_day_start:d.toISOString(),p_day_end:e.toISOString(),p_week_start:ws.toISOString(),p_week_end:new Date(ws.getTime()+7*86400000).toISOString(),p_month_start:ms.toISOString(),p_month_end:dateFromKey(`${mn}-01`).toISOString()}};
const select='id,item_name,size,pieces,rate_per_piece,commission_type,commission_value,commission_mode,commission_per_piece,actual_rate_per_piece,total,occurred_at,special_note';
export function ContractorPersonalDashboard({profileId,displayName}:Props){
 const todayKey=dayKey(new Date());const[entries,setEntries]=useState<Entry[]>([]);const[totals,setTotals]=useState(zero);const[loading,setLoading]=useState(true);const[saving,setSaving]=useState(false);const[error,setError]=useState('');const[newOpen,setNewOpen]=useState(false);const[detail,setDetail]=useState<{type:PeriodCard;period:Period;entries:Entry[]}|null>(null);const[detailLoading,setDetailLoading]=useState(false);const[visibleCount,setVisibleCount]=useState(5);const[menuId,setMenuId]=useState<string|null>(null);const[viewEntry,setViewEntry]=useState<Entry|null>(null);const[editEntry,setEditEntry]=useState<Entry|null>(null);const[deleteEntry,setDeleteEntry]=useState<Entry|null>(null);const[periodCursors,setPeriodCursors]=useState<Record<PeriodCard,string>>({daily:todayKey,weekly:todayKey,monthly:todayKey,grand:todayKey});
 const load=async()=>{setLoading(true);const[a,b]=await Promise.all([supabase.from('contractor_work_entries').select(select).eq('profile_id',profileId).order('occurred_at',{ascending:false}).order('id',{ascending:false}).limit(60),supabase.rpc('get_contractor_work_totals',bounds())]);if(a.error){setError(a.error.message);setLoading(false);return}if(b.error){setError(b.error.message);setLoading(false);return}setEntries((a.data??[])as Entry[]);const r=Array.isArray(b.data)?b.data[0]:b.data;setTotals({...zero,...(r??{})});setLoading(false)};useEffect(()=>{void load()},[profileId]);
 const saveEntry=async(input:ContractorEntryInput)=>{setSaving(true);const r=await supabase.from('contractor_work_entries').insert({profile_id:profileId,...input});setSaving(false);if(r.error){setError(r.error.message);return{error:r.error}}setNewOpen(false);await load();return{error:null}};
 const openDetail=async(t:PeriodCard,k:string)=>{setDetailLoading(true);setVisibleCount(5);setMenuId(null);const p=periodFor(t,k);let q=supabase.from('contractor_work_entries').select(select).eq('profile_id',profileId).order('occurred_at',{ascending:false}).order('id',{ascending:false}).limit(1000);if(p.start&&p.end)q=q.gte('occurred_at',new Date(p.start).toISOString()).lt('occurred_at',new Date(p.end).toISOString());const r=await q;if(r.error){setError(r.error.message);setDetailLoading(false);return}const rows=(r.data??[])as Entry[];setDetail({type:t,period:{...p,total:t==='grand'?Number(totals.lifetime_total):rows.reduce((s,x)=>s+Number(x.total||0),0),commission:rows.reduce((s,x)=>s+Number(x.commission_per_piece||0)*Number(x.pieces||0),0)},entries:rows});setDetailLoading(false)};
 const moveDetail=(dir:-1|1)=>{if(!detail||detail.type==='grand')return;const c=periodCursors[detail.type];let n=c;if(detail.type==='daily')n=shiftDayKey(c,dir);else if(detail.type==='weekly')n=shiftDayKey(weekStartKey(c),dir*7);else{const b=dateFromKey(monthStartKey(c)),x=new Date(b.getTime()+dir*32*86400000);n=`${x.getUTCFullYear()}-${String(x.getUTCMonth()+1).padStart(2,'0')}-01`}if(dir===1&&n>todayKey)return;setPeriodCursors(x=>({...x,[detail.type]:n}));void openDetail(detail.type,n)};
 const updateEntry=async(id:string,input:Partial<Entry>)=>{setSaving(true);const r=await supabase.from('contractor_work_entries').update(input).eq('id',id).eq('profile_id',profileId);setSaving(false);if(r.error){setError(r.error.message);return{error:r.error}}setEditEntry(null);await load();if(detail)await openDetail(detail.type,periodCursors[detail.type]);return{error:null}};
 const removeEntry=async()=>{if(!deleteEntry)return;setSaving(true);const r=await supabase.from('contractor_work_entries').delete().eq('id',deleteEntry.id).eq('profile_id',profileId);setSaving(false);if(r.error){setError(r.error.message);return}setDeleteEntry(null);await load();if(detail)await openDetail(detail.type,periodCursors[detail.type])};
 const EntryRow=({entry}:{entry:Entry})=><article className="cd-entry"><div className="cd-entry-top"><div><div className="cd-entry-name">{entry.item_name}</div><div className="cd-entry-meta">{new Intl.DateTimeFormat('en-PK',{timeZone:'Asia/Karachi',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(entry.occurred_at))} · Size {entry.size} · {formatContractorMoney(entry.pieces)} pieces · PKR {formatContractorMoney(entry.actual_rate_per_piece)}/piece actual</div></div><div className="cd-row-actions"><div className="cd-entry-total">PKR {formatContractorMoney(entry.total)}</div><button className="cd-more" type="button" aria-label="Entry actions" onClick={()=>setMenuId(menuId===entry.id?null:entry.id)}>•••</button>{menuId===entry.id&&<div className="cd-menu"><button onClick={()=>{setViewEntry(entry);setMenuId(null)}}>View Details</button><button onClick={()=>{setEditEntry(entry);setMenuId(null)}}>Edit</button><button className="danger" onClick={()=>{setDeleteEntry(entry);setMenuId(null)}}>Delete</button></div>}</div></div>{entry.commission_type&&entry.commission_mode?<span className="cd-badge">{entry.commission_type==='percentage'?`${entry.commission_value}%`:`PKR ${entry.commission_value}/piece`} · {entry.commission_mode==='included'?'Included':'Extra'}</span>:<span className="cd-badge">Commission not provided</span>}</article>;
 const cards=useMemo(()=>[{type:'daily' as const,label:'Today',value:totals.daily_total,icon:'◷'},{type:'weekly' as const,label:'Weekly',value:totals.weekly_total,icon:'↗'},{type:'monthly' as const,label:'Monthly',value:totals.monthly_total,icon:'▣'},{type:'grand' as const,label:'Grand Total',value:totals.lifetime_total,icon:'◆'}],[totals]);
 return <main className="contractor-dashboard" style={{width:'100%',maxWidth:1080,margin:'0 auto',padding:'clamp(14px,3vw,26px) clamp(9px,2.5vw,20px) 104px',boxSizing:'border-box',color:'#172033'}}><style>{`.contractor-dashboard{--ink:#172033;--muted:#64748b}.cd-hero{padding:16px;border-radius:20px;background:linear-gradient(145deg,#fff,#f3fbfa 60%,#eef5ff);border:1px solid rgba(20,184,166,.16);box-shadow:inset 0 1px 0 #fff,0 16px 30px rgba(15,23,42,.08)}.cd-kicker{color:#0f766e;font-size:9px;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.cd-title{margin:4px 0;font-size:clamp(28px,7vw,42px);line-height:1;font-weight:950}.cd-sub{margin:7px 0;font-size:12px;color:#64748b}.cd-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.cd-btn{min-height:39px;padding:0 12px;border-radius:12px;border:1px solid rgba(71,85,105,.15);font:inherit;font-size:11px;font-weight:900;cursor:pointer;background:linear-gradient(145deg,#fff,#eef3f5);color:#334155}.cd-btn-primary{color:#fff;background:linear-gradient(145deg,#14b8a6,#0f766e 55%,#2563eb)}.cd-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:12px}.cd-card{width:100%;padding:12px;border-radius:17px;border:1px solid rgba(255,255,255,.82);background:linear-gradient(145deg,#fff,#f7fafb);box-shadow:inset 0 1px 0 #fff,0 9px 18px rgba(15,23,42,.07);text-align:left;cursor:pointer;font:inherit;color:inherit}.cd-card-head{display:flex;align-items:center;justify-content:space-between}.cd-icon{display:grid;place-items:center;width:29px;height:29px;border-radius:10px;background:#e8f9f6;color:#0f766e;font-weight:950}.cd-label{font-size:9px;color:#64748b;font-weight:900;text-transform:uppercase}.cd-value{margin-top:5px;font-size:19px;font-weight:950}.cd-tap{margin-top:7px;font-size:8px;color:#0f766e;font-weight:900}.cd-section,.cd-commission{margin-top:12px;padding:13px;border-radius:18px;border:1px solid rgba(99,102,241,.13);background:linear-gradient(145deg,#fff,#f8fafc);box-shadow:inset 0 1px 0 #fff,0 10px 20px rgba(15,23,42,.055)}.cd-commission{border-color:rgba(22,163,74,.18);background:linear-gradient(145deg,#f0fdf4,#ecfdf5 54%,#eff6ff)}.cd-commission-row{display:flex;justify-content:space-between;align-items:center}.cd-commission-value{font-size:24px;font-weight:950;color:#15803d}.cd-entry{position:relative;padding:10px;border-radius:14px;border:1px solid rgba(148,163,184,.14);background:linear-gradient(145deg,#fff,#f5f8f9);box-shadow:inset 0 1px 0 #fff,0 4px 9px rgba(15,23,42,.045)}.cd-entry+.cd-entry{margin-top:7px}.cd-entry-top{display:flex;justify-content:space-between;gap:9px}.cd-entry-name{font-size:13px;font-weight:950}.cd-entry-meta{margin-top:3px;font-size:10px;color:#64748b}.cd-entry-total{font-size:14px;font-weight:950;white-space:nowrap}.cd-row-actions{position:relative;display:flex;gap:5px;align-items:flex-start}.cd-more{width:31px;height:28px;border:1px solid rgba(71,85,105,.12);border-radius:10px;background:linear-gradient(145deg,#fff,#eef4f6);font-weight:950;letter-spacing:2px;color:#475569}.cd-menu{position:absolute;right:0;top:33px;z-index:20;min-width:145px;padding:6px;border-radius:14px;border:1px solid rgba(255,255,255,.85);background:linear-gradient(145deg,#fff,#eef5ff);box-shadow:0 16px 35px rgba(15,23,42,.18)}.cd-menu button{display:block;width:100%;padding:9px 10px;border:0;border-radius:9px;background:transparent;text-align:left;font:inherit;font-size:11px;font-weight:850;color:#334155}.cd-menu .danger{color:#b91c1c}.cd-badge{display:inline-flex;margin-top:7px;padding:5px 8px;border-radius:999px;font-size:9px;font-weight:900;border:1px solid rgba(20,184,166,.15);background:#f0fdfa;color:#0f766e}.cd-empty{padding:24px;text-align:center;color:#64748b;font-size:11px}.cd-error{margin-top:11px;padding:10px;border-radius:12px;background:#fff7f7;color:#b91c1c;font-size:11px}.cd-detail-overlay,.cex-overlay{position:fixed!important;inset:0!important;z-index:1200!important;display:flex!important;align-items:flex-start!important;justify-content:center!important;overflow:auto!important;box-sizing:border-box!important;padding:18px 12px calc(88px + env(safe-area-inset-bottom))!important;background:rgba(15,23,42,.38);backdrop-filter:blur(7px)}.cd-detail,.cex-modal{width:min(100%,680px);max-height:calc(100dvh - 112px - env(safe-area-inset-bottom));overflow:auto;box-sizing:border-box;margin:0;border-radius:24px;border:1px solid rgba(255,255,255,.86);background:linear-gradient(145deg,#fff,#f7fbfb 58%,#eef4ff);box-shadow:0 28px 70px rgba(15,23,42,.26),inset 0 1px 0 #fff;padding:15px}.cd-detail-head{display:flex;justify-content:space-between;gap:10px}.cd-detail-title{margin:0;font-size:21px;font-weight:950}.cd-detail-label{margin-top:4px;color:#64748b;font-size:10px}.cd-detail-nav{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:13px 0 10px;padding:8px;border-radius:15px;background:rgba(255,255,255,.72);border:1px solid rgba(148,163,184,.15)}.cd-nav-btn{min-height:34px;padding:0 11px;border-radius:10px;border:1px solid rgba(71,85,105,.14);background:#fff;font:inherit;font-size:10px;font-weight:900}.cd-detail-total{font-size:25px;font-weight:950}.cd-detail-commission{font-size:10px;color:#15803d;font-weight:900}.cd-close{width:34px;height:34px;border-radius:11px;border:1px solid rgba(71,85,105,.13);background:#fff;font-size:17px}.cd-more-btn{width:100%;margin-top:10px;min-height:38px;border:1px solid rgba(20,184,166,.2);border-radius:12px;background:linear-gradient(145deg,#fff,#e8f9f6);color:#0f766e;font:inherit;font-size:11px;font-weight:950}.cd-detail-list{margin-top:12px}.cex-modal{width:min(100%,560px)}.cex-top{display:flex;justify-content:space-between}.cex-top h2{margin:4px 0;font-size:22px}.cex-top p{margin:4px 0;font-size:10px;color:#64748b}.cex-kicker{font-size:9px;font-weight:950;letter-spacing:.13em;color:#0f766e;text-transform:uppercase}.cex-close{width:34px;height:34px;border-radius:11px;border:1px solid rgba(71,85,105,.13);background:#fff;font-size:17px}.cex-grid{display:grid;gap:9px;margin-top:12px}.cex-grid label{display:grid;gap:4px;font-size:11px;font-weight:850}.cex-two{display:grid;grid-template-columns:1fr 1fr;gap:7px}.cex-section-title{font-size:10px;font-weight:950;color:#475569}.cex-commission{padding:11px;border-radius:16px;background:linear-gradient(145deg,#effdfa,#eef5ff);border:1px solid rgba(20,184,166,.16)}.cex-opt,.cex-skip,.cex-save{min-height:38px;border-radius:11px;font:inherit;font-size:10px;font-weight:900}.cex-opt{border:1px solid rgba(100,116,139,.16);background:#fff}.cex-opt.selected{border-color:rgba(5,150,105,.35);background:#ecfdf5;color:#047857}.cex-skip{margin-top:7px;border:1px solid rgba(100,116,139,.15);background:#fff}.cex-preview{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px;border-radius:14px;background:#f0fdfa;border:1px solid rgba(20,184,166,.18)}.cex-preview small{display:block;font-size:8px;color:#64748b}.cex-preview strong{display:block;margin-top:3px;font-size:17px;color:#0f766e}.cex-save{border:0;background:linear-gradient(145deg,#14b8a6,#0f766e 55%,#2563eb);color:#fff;min-height:44px}.cex-error{padding:8px;border-radius:10px;background:#fff7f7;color:#b91c1c;font-size:10px;font-weight:800}@media(min-width:760px){.cd-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.cd-detail-overlay,.cex-overlay{padding-top:28px!important;padding-bottom:92px!important}.cd-detail,.cex-modal{max-height:calc(100dvh - 132px - env(safe-area-inset-bottom))}}@media(max-width:430px){.cd-detail-overlay,.cex-overlay{padding-left:8px!important;padding-right:8px!important;padding-bottom:88px!important}}`}</style>
 <section className="cd-hero"><div className="cd-kicker">Contractor Personal Dashboard</div><h1 className="cd-title">Welcome{displayName?`, ${displayName}`:''}</h1><p className="cd-sub">Your personal work overview — compact, real, and commission-aware.</p><div className="cd-actions"><button className="cd-btn" onClick={()=>navigate('/work/contractor?view=settings')}>Settings</button><button className="cd-btn cd-btn-primary" onClick={()=>setNewOpen(true)}>＋ New Entry</button></div></section>
 {error&&<div className="cd-error">{error}</div>}<section className="cd-grid">{cards.map(c=><button className="cd-card" key={c.type} onClick={()=>void openDetail(c.type,periodCursors[c.type])}><div className="cd-card-head"><span className="cd-icon">{c.icon}</span><span className="cd-label">{c.label}</span></div><div className="cd-value">PKR {formatContractorMoney(c.value)}</div><div className="cd-tap">Tap for details & history</div></button>)}</section>
 <section className="cd-commission"><div className="cd-commission-row"><div><div className="cd-label">Commission</div><div className="cd-commission-value">PKR {formatContractorMoney(totals.commission_total)}</div></div><span className="cd-badge">Recorded commission</span></div></section><section className="cd-section"><div className="cd-entry-name">Team Work</div><div className="cd-entry-meta">Your contractor team workspace entry point. Team execution stays separate from personal work entries.</div><span className="cd-badge">Foundation</span></section>
 <section className="cd-section"><div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:9}}><div><h2 style={{margin:0,fontSize:15}}>Recent Entries</h2><div style={{marginTop:3,fontSize:10,color:'#64748b'}}>{loading?'Loading…':`${entries.length} recent entries`}</div></div><button className="cd-btn" onClick={()=>void load()} disabled={loading}>↻ Refresh</button></div>{!loading&&!entries.length?<div className="cd-empty">No entries yet.</div>:entries.map(e=><EntryRow key={e.id} entry={e}/>)}</section>
 {detail&&<div className="cd-detail-overlay" onMouseDown={e=>{if(e.target===e.currentTarget)setDetail(null)}}><section className="cd-detail" role="dialog" aria-modal="true"><div className="cd-detail-head"><div><h2 className="cd-detail-title">{detail.type==='daily'?'Daily Work':detail.type==='weekly'?'Weekly Work':detail.type==='monthly'?'Monthly Work':'Grand Total History'}</h2><div className="cd-detail-label">{detail.period.label}</div></div><button className="cd-close" onClick={()=>setDetail(null)}>×</button></div><div className="cd-detail-nav">{detail.type!=='grand'?<button className="cd-nav-btn" onClick={()=>moveDetail(-1)}>← Previous</button>:<span/>}<div style={{textAlign:'center'}}><div className="cd-detail-total">PKR {formatContractorMoney(detail.period.total)}</div><div className="cd-detail-commission">Commission PKR {formatContractorMoney(detail.period.commission)}</div></div>{detail.type!=='grand'?<button className="cd-nav-btn" onClick={()=>moveDetail(1)} disabled={detailLoading||periodCursors[detail.type]>=todayKey}>Next →</button>:<span/>}</div>{detailLoading?<div className="cd-empty">Loading real records…</div>:!detail.entries.length?<div className="cd-empty">No work recorded for this period.</div>:<><div className="cd-detail-list">{detail.entries.slice(0,visibleCount).map(e=><EntryRow key={e.id} entry={e}/>)}</div>{visibleCount<detail.entries.length&&<button className="cd-more-btn" onClick={()=>setVisibleCount(v=>Math.min(v+10,detail.entries.length))}>View More · show next 10</button>}</>}</section></div>}
 {viewEntry&&<div className="cd-detail-overlay" onMouseDown={e=>{if(e.target===e.currentTarget)setViewEntry(null)}}><section className="cd-detail" role="dialog" aria-modal="true"><div className="cd-detail-head"><div><div className="cd-kicker">Full Work Record</div><h2 className="cd-detail-title">{viewEntry.item_name}</h2><div className="cd-detail-label">Real entry details</div></div><button className="cd-close" onClick={()=>setViewEntry(null)}>×</button></div><section className="cd-section"><div className="cd-entry-meta">Date & Time</div><div className="cd-entry-name">{new Intl.DateTimeFormat('en-PK',{timeZone:'Asia/Karachi',dateStyle:'medium',timeStyle:'short'}).format(new Date(viewEntry.occurred_at))}</div><div className="cd-entry-meta">Size</div><div className="cd-entry-name">{viewEntry.size}</div><div className="cd-entry-meta">Pieces</div><div className="cd-entry-name">{formatContractorMoney(viewEntry.pieces)}</div><div className="cd-entry-meta">Entered Rate / Piece</div><div className="cd-entry-name">PKR {formatContractorMoney(viewEntry.rate_per_piece)}</div><div className="cd-entry-meta">Actual Rate / Piece</div><div className="cd-entry-name">PKR {formatContractorMoney(viewEntry.actual_rate_per_piece)}</div><div className="cd-entry-meta">Commission</div><div className="cd-entry-name">{viewEntry.commission_type?`${viewEntry.commission_type==='percentage'?`${viewEntry.commission_value}%`:`PKR ${viewEntry.commission_value}/piece`} · ${viewEntry.commission_mode==='included'?'Included / Minus':'Extra / Add'}`:'Not provided'}</div><div className="cd-entry-meta">Commission / Piece</div><div className="cd-entry-name">PKR {formatContractorMoney(viewEntry.commission_per_piece)}</div><div className="cd-entry-meta">Total</div><div className="cd-detail-total">PKR {formatContractorMoney(viewEntry.total)}</div>{viewEntry.special_note&&<><div className="cd-entry-meta">Special Note</div><div className="cd-entry-name">{viewEntry.special_note}</div></>}</section></section></div>}
 {deleteEntry&&<div className="cd-detail-overlay"><section className="cd-detail" role="dialog" aria-modal="true"><div className="cd-kicker">Confirm Action</div><h2 className="cd-detail-title">Delete this entry?</h2><p className="cd-entry-meta">This permanently removes <strong>{deleteEntry.item_name}</strong>.</p><div className="cex-two" style={{marginTop:14}}><button className="cd-btn" onClick={()=>setDeleteEntry(null)}>Cancel</button><button className="cd-btn" style={{color:'#b91c1c'}} onClick={()=>void removeEntry()} disabled={saving}>{saving?'Deleting…':'Delete Entry'}</button></div></section></div>}
 <ContractorNewEntryModal open={newOpen} saving={saving} onClose={()=>setNewOpen(false)} onSave={saveEntry}/><ContractorEntryEditModal entry={editEntry} saving={saving} onClose={()=>setEditEntry(null)} onSave={updateEntry}/></main>;
}
